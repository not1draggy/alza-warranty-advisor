# ---------------------------------------------------------------------------
# Warranty Advisor AI — environment configuration
# Copy to `.env` and fill in the values you have. The stack boots without any
# provider key; analyses then report "insufficient evidence" instead of
# inventing data.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000

# --- Database ---------------------------------------------------------------
POSTGRES_USER=warranty
POSTGRES_PASSWORD=warranty
POSTGRES_DB=warranty
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- LLM providers ----------------------------------------------------------
# Anthropic is the primary reasoning provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# OpenAI is used for embeddings (and as an optional LLM fallback).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Search providers (at least one recommended) ----------------------------
TAVILY_API_KEY=
SERPAPI_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# --- Behaviour --------------------------------------------------------------
ANALYSIS_CACHE_TTL_SECONDS=604800
SEARCH_CACHE_TTL_SECONDS=86400
MAX_SEARCH_RESULTS=24
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# --- Frontend ---------------------------------------------------------------
# Leave empty. The web app calls the API on its own origin and the Next.js
# server forwards the request, so no cross-origin request and no second public
# port are involved. Set this only to point the browser at an API on a
# different host, which then has to be listed in CORS_ORIGINS above.
NEXT_PUBLIC_API_URL=
